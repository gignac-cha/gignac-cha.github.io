{
  "name": "footprint",
  "version": "0.1.0",
  "description": "Tiny page-access footprint tracker — one step() call, sendBeacon transport, endpoint resolved from browser storage.",
  "type": "module",
  "types": "./outputs/index.d.ts",
  "exports": {
    ".": {
      "types": "./outputs/index.d.ts",
      "import": "./outputs/index.js"
    },
    "./step": {
      "types": "./outputs/footprint.d.ts",
      "import": "./outputs/footprint.js"
    }
  },
  "scripts": {
    "build": "tsc && esbuild index.ts --bundle --platform=browser --target=esnext --format=esm --outfile=outputs/footprint.bundle.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "pnpm build && playwright test",
    "publish:npm": "node --env-file-if-exists=.env publish.ts"
  },
  "author": "Jin-Hyeok Cha",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.1.1",
    "esbuild": "^0.28.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
